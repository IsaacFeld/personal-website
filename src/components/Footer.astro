<script>
var d = document.documentElement
document.querySelectorAll('#discord')[0].addEventListener('click', () =>{
    copyDiscord()
})
function copyDiscord(){
    // Copy the text inside the text field
    navigator.clipboard.writeText('pugcy');
    document.querySelectorAll('#discordalert')[0].style.display = "block"
    document.querySelectorAll('#discordalert')[0].classList.add('out')

    setTimeout(() => {
        document.querySelectorAll('#discordalert')[0].classList.remove('out')
        setTimeout(() =>{
            document.querySelectorAll('#discord')[0].style.pointerEvents = 'all'
            document.querySelectorAll('#discordalert')[0].style.display = "none"
      }, 200)
    }, 1000)
}

</script>
