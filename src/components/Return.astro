---
const { link } = Astro.props;
---
<script>
const returnButton = document.querySelector('.returnButton');

if(returnButton){
  const link = returnButton.getAttribute('data-link');  
  returnButton.addEventListener('click', () => {
    returnButton.classList.add('animate');
    setTimeout(() => {
      document.location.href = `${link}`;
    }, 300); 
  })
}

</script>

<div class="returnButton" data-link={link}>
    <svg version="1.1" width="32" height="32" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
        <rect x="10" y="6" width="2" height="2" fill="#000000" />
        <rect x="8" y="8" width="2" height="2" fill="#000000" />
        <rect x="6" y="10" width="2" height="6" fill="#000000" />
        <rect x="4" y="12" width="2" height="2" fill="#000000" />
        <rect x="8" y="12" width="14" height="2" fill="#000000" />
        <rect x="22" y="14" width="2" height="2" fill="#000000" />
        <rect x="8" y="16" width="2" height="2" fill="#000000" />
        <rect x="24" y="16" width="2" height="4" fill="#000000" />
        <rect x="10" y="18" width="2" height="2" fill="#000000" />
        <rect x="22" y="20" width="2" height="2" fill="#000000" />
        <rect x="20" y="22" width="2" height="2" fill="#000000" />
        <rect x="14" y="24" width="6" height="2" fill="#000000" />
    </svg>
</div>

<style>
.returnButton rect{
    fill: var(--text-color);
    scale: 2;
}
.returnButton svg {
    width: 64px;
    height: 64px;
}
.returnButton{
    background-color: var(--bg2-color);
    width: fit-content;
    height:fit-content;
    display: flex;
    flex-direction: row;
    align-self: start;
    align-items: center;
    justify-content: center;
    padding: 0.5em;
    border-radius: 2em;
    position: fixed;
    bottom: 2em;
    left: 2em;
    box-shadow: var(--box-shadow) 0px 2px 15px;
    transition: all 0.3s ease-in;
}

.returnButton:hover{
    box-shadow: var(--primary-color) 0px 2px 5px;
}
.returnButton:hover rect{
    fill: var(--primary-color);
}

@media screen and (max-width: 800px){
    .returnButton.animate{
        box-shadow: var(--primary-color) 0px 2px 5px;
    }
    
    .returnButton.animate rect{
        fill: var(--primary-color);
    }

    .returnButton rect{
        scale: 1;
    }
    .returnButton svg{
        width: 32px;
        height: 32px;
    }
    .returnButton{
        left: 1em;
    }
}
</style>