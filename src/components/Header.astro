                </label>
            </div>


                    

        </div>
    </div>
    <hamburger-menu class="hamburger-element">
        <div class="col hamburger-container hamburger-element">
            <div class="row-center hamburger-element">
                <div class="navp-container hamburger-element">
                    <a href="/" class="navp ${page == '' ? 'active' : ''}">home</a>
