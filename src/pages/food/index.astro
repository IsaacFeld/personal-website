---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css"
import { getCollection } from "astro:content";

const posts = await getCollection('foodblog');

---

<Layout pageName="food">
    <ul>
        {posts.map((post) => (
        <li>
            <a href={`/food/${post.id}`}> {post.data.title}</a>
        </li>
        ))}
    </ul>
</Layout>