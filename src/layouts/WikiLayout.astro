---
import Footer from '../components/Footer.astro';
import  Return from '../components/Return.astro';
import BlogThemeIcon from '../components/BlogThemeIcon.astro'
import { Font } from 'astro:assets';
import "../styles/global.css";

const { article } = Astro.props

const title = article.data.name.replace(".md", "")
---
<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<link rel="icon" href="/favicon.ico" />

		<Font cssVariable="--font-arimo" />
		<Font cssVariable="--font-indie" />
		<!-- Load KaTeX CSS and JS -->
        <link is-inline rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
        <script is-inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
        <!-- Load Auto-render extension -->
        <script is-inline defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"
            onload="renderMathInElement(document.body);"></script>
		<meta name="generator" content={Astro.generator} />
		<title>isaac's website - {title}</title>
		<wikiarticle>
		    <outline>
						<div style="display: flex; flex-direction: row; justify-content: space-between; column-gap: 1em;">
						    <p style="font-size: var(--font-big); color: var(--text-highlight)">Article Outline</p>
							<div id="outlineController">
							  <svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right-close preview-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/></svg>
							</div>
						</div>
			</outline>
		    <metadata>
					<h1 class="wikiarticle-title">{title}</h1>
					<div class="wikitags">{article.data.tags.map((tag: string) => (<wikitag>{tag}</wikitag>))}</div>

					<div class="wikiarticle-status">
					Written {new Date(article.data.written).toLocaleDateString()} <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-feather-icon lucide-feather"><path d="M14.086 18.412A2 2 0 0112.67 19H5v-7.672a2 2 0 01.586-1.414L11.75 3.75a6 6 0 118.49 8.49z"/><path d="M16 8 2 22"/><path d="M17.488 15H9"/></svg> </div>

					{article.data.summary.length > 37 ?		<summary>
					<h2 class="wikiarticle-summary-title">Summary</h2>
					<div set:html={article.data.summary}></div>
					</summary> : '' }


			</metadata>
            <div class="textbox" style="padding-top: 0em;">
                <slot />
                {article.data.related.length != 0 ?   <div class="wikiRelatedContainer">
                    <h2 id="Related Articles"> Related Articles</h2>
                {article.data.related.map((relatedArticleName : string) => {
                let url = `/wiki/${relatedArticleName.trim().replaceAll(" ", "-").replaceAll("(", "").replaceAll(")", "").toLowerCase()}`;
                  return <a class="wikiLink" href={url}> {relatedArticleName} </a>
                })}
                </div> : ""}
                {article.data.footnotes.length != 0 ? <div class="wikiFootNotesContainer">
                    <h2 id="Footnotes">Footnotes</h2>
                    {article.data.footnotes ? article.data.footnotes.map((footnote : string, i : number) => {
                    return <div class="wikiFootNoteContainer"> <wikiFootNote id={"footnote-" + (i+1)}>{i+1}</wikiFootNote> <div set:html={footnote}> </div></div>
                    }) : ""}
                </div> : ""}


                <Footer />
            </div>


            <Return link={"/wiki"} />
            <div class="blogThemeContainer">
                <BlogThemeIcon />
            </div>


		</wikiarticle>

</head>

<script is-inline>
let headerColors = {
  "H1": "--wiki-red",
  "H2": "--wiki-yellow",
  "H3": "--wiki-green",
  "H4": "--wiki-aqua",
  "H5": "--wiki-blue",
  "H6": "--wiki-purple",
}

let headerMargins = {
  "H1": "0px",
  "H2": "8px",
  "H3": "16px",
  "H4": "24px",
  "H5": "32px",
  "H6": "40px",
}
document.addEventListener("DOMContentLoaded", function() {
    // renderMathInElement is now globally available!
    renderMathInElement(document.body, {
      delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$', right: '$', display: false}, // This enables Obsidian's inline math
          {left: '\\(', right: '\\)', display: false},
          {left: '\\[', right: '\\]', display: true}
      ],
      // Optional: Throw an error in the console if LaTeX is invalid, rather than crashing
      throwOnError: false

      
    });

    let outlineHTML = "<div id='outlineLinkContainer'>"
    let lastHeader = "H1"
    let headers = document.querySelectorAll('h1, h2, h3, h4, h5, h6')
    headers.forEach((el) => {
      if(!el.classList.contains('wikiarticle-title') && !el.classList.contains('wikiarticle-summary-title') ){
        outlineHTML += `<a class="outlineLink" style="color: var(${headerColors[el.nodeName]}); margin-left: ${headerMargins[el.nodeName]}; text-decoration: none; " href="#${el.id}" > ${el.id} </a>`
        lastHeader = el.nodeName
      }
    })
    let h6 = document.querySelectorAll('h6')
    let outline = document.querySelector('outline');
    outlineHTML += "</div>"
    outline.innerHTML += outlineHTML;

    let outlineIsOpenSVG = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right-open preview-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/><path d="m10 15-3-3 3-3"/></svg>`
    let outlineIsClosedSVG = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-panel-right-close preview-icon"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/><path d="m8 9 3 3-3 3"/></svg>`
    let outlineControllerEl = document.querySelector('#outlineController')
    
    console.log(outlineControllerEl)
    
    
    outlineControllerEl.onclick = (() => {
      
      outlineControllerEl.classList.toggle('open');
      if(outlineControllerEl.classList.contains('open')){
        outlineControllerEl.innerHTML = outlineIsOpenSVG
      }
      else{
        outlineControllerEl.innerHTML = outlineIsClosedSVG;
      }
      });
  });

</script>
