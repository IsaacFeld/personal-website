---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Snowfall from "astro-snowfall"
import { Font } from 'astro:assets';

interface Props {
  pageName: string;
}
const { pageName } = Astro.props
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<script is:inline>
          (function() {
            const theme = localStorage.getItem("theme");
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            
            if (theme === 'light' || (!theme && !prefersDark)) {
              document.documentElement.classList.add('lightmode');
            } else {
              document.documentElement.classList.remove('lightmode');
            }
          })();
        </script>
		<Font cssVariable="--font-arimo" />
		<Font cssVariable="--font-indie" />
		<meta name="generator" content={Astro.generator} />
		<title>isaac's website</title>
	</head>
	<body>
    	<div style="position: fixed; inset: 0; z-index: 0; pointer-events: none;">
        <Snowfall  
            color="#ffffff"
            snowflakeCount={30}
            speed={[0.5, 2.0]}
            wind={[-0.3, 0.6]}
          />
        </div> 
        <div class="center"> 
        <Header pageName={pageName} />
            <slot />
		<Footer />
        </div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	


</style>
