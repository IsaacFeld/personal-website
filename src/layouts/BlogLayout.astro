---
import Footer from '../components/Footer.astro';
import  Return from '../components/Return.astro';
import BlogThemeIcon from '../components/BlogThemeIcon.astro'
import { Font } from 'astro:assets';
import "../styles/global.css";

import goldStarBorder from "../assets/stars/goldStarBorder.svg";
import goldHalfStarBorder from "../assets/stars/goldHalfStarBorder.svg";


import silverStarBorder from "../assets/stars/silverStarBorder.svg";
import silverHalfStarBorder from "../assets/stars/silverHalfStarBorder.svg";


import bronzeStarBorder from "../assets/stars/bronzeStarBorder.svg";
import bronzeHalfStarBorder from "../assets/stars/bronzeHalfStarBorder.svg";


import blueStarBorder from "../assets/stars/blueStarBorder.svg";
import blueHalfStarBorder from "../assets/stars/blueHalfStarBorder.svg";


import greenStarBorder from "../assets/stars/greenStarBorder.svg";
import greenHalfStarBorder from "../assets/stars/greenHalfStarBorder.svg";



const { blog } = Astro.props
const { title, subtitle, description, rating, tags, links, published, updated } = blog.data;

function getSrc(rating: any){
  switch (Math.round(rating)) {
    case 0:
    return blueStarBorder.src
    case 1:
    return blueStarBorder.src
    case 2:
    return greenStarBorder.src
    case 3:
    return bronzeStarBorder.src;
    case 4:
    return silverStarBorder.src;
    case 5:
      return goldStarBorder.src;
      
    default: 
      return goldStarBorder.src
    
  }
}

function getHalfSrc(rating: any){
  switch (Math.round(rating)) {
    case 0:
    return blueHalfStarBorder.src
    case 1:
    return blueHalfStarBorder.src
    case 2:
    return greenHalfStarBorder.src
    case 3:
    return bronzeHalfStarBorder.src;
    case 4:
    return silverHalfStarBorder.src;
    case 5:
      return goldHalfStarBorder.src;
      
    default: 
      return goldHalfStarBorder.src
    
  }
}
  
const serviceSrc = getSrc(rating.service);
const foodSrc = getSrc(rating.food);
const atmosphereSrc = getSrc(rating.atmosphere)

const serviceHalfSrc = getHalfSrc(rating.service);
const foodHalfSrc = getHalfSrc(rating.food);
const atmosphereHalfSrc = getHalfSrc(rating.atmosphere);
---

<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
	
		<link rel="icon" href="/favicon.ico" />
		
		<Font cssVariable="--font-arimo" />  
		<Font cssVariable="--font-indie" />
		<meta name="generator" content={Astro.generator} />
		<title>isaac's website</title>
</head>
<body>
    <foodpage>
        <div class="center">

            <div class="between reviewDataContainer sticky row" style="align-items: center; padding: 1em 0em; row-gap: 1em">  
                <h2 style="font-family: var(--font-indie);">{subtitle}</h2> 
                <div class="row ratingContainer">
                    <div class="col">
                        
                        <tag>
                            <div style="flex-direction: row; display: flex;">
                            {() => {
                              const stars = [];
                              for (let i = 0; i < Math.floor(rating.service); i++){
                               stars.push(<img class="starIcon" src={serviceSrc} />)
                              }
                              if(rating.service % 1 !== 0){
                                stars.push(<img class="starIcon" src={serviceHalfSrc} />)
                              }
                              return stars;
                            }
                            }
                            </div>
                        </tag>
                        <p style="margin-top: 0.25em; font-size: var(--font-big)">Service</p>
                    </div>
                    <div class="col">
                        
                        <tag>
                            <div style="flex-direction: row; display: flex;">
                            {() => {
                              const stars = [];
                              for (let i = 0; i < Math.floor(rating.food); i++){
                               stars.push(<img class="starIcon" src={foodSrc} />)
                              }
                              if(rating.food % 1 !== 0){
                                stars.push(<img class="starIcon" src={foodHalfSrc} />)
                              }
                              return stars;
                            }
                            }
                            </div>
                        </tag>
                        <p style="margin-top: 0.25em; font-size: var(--font-big)">Food</p>
                        
                    </div>
                    <div class="col">
                        
                        <tag>
                            <div style="flex-direction: row; display: flex;">
                            {() => {
                              const stars = [];
                              for (let i = 0; i < Math.floor(rating.atmosphere); i++){
                               stars.push(<img class="starIcon" src={atmosphereSrc} />)
                              }
                              if(rating.atmosphere % 1 !== 0){
                                stars.push(<img class="starIcon" src={atmosphereHalfSrc} />)
                              }
                              return stars;
                            }
                            }
                            </div>
                        </tag>
                        <p style="margin-top: 0.25em; font-size: var(--font-big)">Atmosphere</p>
                    </div>
               
                </div>
                <div class="row-center tagContainer" style="margin-bottom: 0px; height: 60px">
                    {tags.map((tag: any) => (
                    <tag>{tag}</tag>
                    ))}
                </div>
      
            </div>
            <div class="textbox" style="padding-top: 0em;">


                <slot />
                
            </div>
            <Return link={"/food"} />
            <div class="blogThemeContainer">
                <BlogThemeIcon />
            </div>
            
            <Footer />
        </div>

    </foodpage>

</body>


