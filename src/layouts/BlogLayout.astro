                </a>
                <h1 >Isaac's Food Blog - {title}</h1>
                <label class="row-center" for="themetoggle">
                    <svg id="themeicon" viewBox="0 0 24 24" fill="none" height="34px" width="28px"xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M3.32031 11.6835C3.32031 16.6541 7.34975 20.6835 12.3203 20.6835C16.1075 20.6835 19.3483 18.3443 20.6768 15.032C19.6402 15.4486 18.5059 15.6834 17.3203 15.6834C12.3497 15.6834 8.32031 11.654 8.32031 6.68342C8.32031 5.50338 8.55165 4.36259 8.96453 3.32996C5.65605 4.66028 3.32031 7.89912 3.32031 11.6835Z" stroke="#F0EDEA" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                </label>
            </div>
        </header>
        <div class="center">
            <div class="textbox">
                <div class="row-start between reviewDataContainer sticky">
                    <h3 style="margin-bottom: 0.5em; align-self: end">{subtitle}</h3>
                    <div class="row-center ratingContainer">
                        <div class="col">
                            <p>Service</p>
                            <tag>
                                <div style="flex-direction: row; display: flex;">
                                {() => {
                                  
                                  const stars = [];
                                  for (let i = 1; i < rating.service; i++){
                                   stars.push(<img src={serviceSrc} />)
                                  }
                                  return stars;
                                }
                                }
                                </div>
                            </tag>
                        </div>
                        <div class="col">
                            <p>Food</p>
                            <tag>
                                <div style="flex-direction: row; display: flex;">
                                {() => {
                                  const stars = [];
                                  for (let i = 1; i < rating.food; i++){
                                   stars.push(<img src={foodSrc} />)
                                  }
                                  return stars;
                                }
                                }
                                </div>
                            </tag>
                        </div>
                        <div class="col">
                            <p>Atmosphere</p>
                            <tag>
                                <div style="flex-direction: row; display: flex;">
                                {() => {
                                  const stars = [];
                                  for (let i = 1; i < rating.atmosphere; i++){
                                   stars.push(<img src={atmosphereSrc} />)
                                  }
                                  return stars;
                                }
                                }
                                </div>
                            </tag>
                        </div>
                  
                    </div>
                    <div class="row-center tagContainer" style="margin-bottom: 0px; height: 60px">
                        {tags.map((tag: any) => (
                        <tag>{tag}</tag>
                        ))}
                    </div>
          
                </div>
                <slot />
            </div>
            <Footer />
        </div>
        
    </foodpage>
    
</body>

<style>
img {
    width: 16px;
}
</style>
